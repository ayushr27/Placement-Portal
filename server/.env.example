# Copy to .env and fill in. Never commit the real .env.
# On Vercel, set these with `vercel env add <NAME>` instead of a file.

# --- Required. The app refuses to boot without these. ---

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=placement_portal

# Signing key for JWTs. Generate with: openssl rand -hex 32
# Must be >= 32 chars. Placeholder values are rejected at startup.
JWT_HASH_KEY=replace-me-with-openssl-rand-hex-32

# --- Access control ---

# Comma-separated browser origins allowed to call this API.
# Include your deployed frontend and your local dev server.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# One-time shared secret for seeding the first admin via
# POST /register/admin with header: X-Bootstrap-Secret: <this value>
# Once an admin exists the endpoint requires an admin token instead.
# Generate with: openssl rand -hex 24
BOOTSTRAP_SECRET=

# --- Optional. Features degrade gracefully if unset. ---

# Upstash Redis (REST, not the redis:// URL). Caching is skipped if blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP for account-creation and password-reset mail.
# For Gmail use an App Password, not your account password.
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address shown to recipients. Defaults to MAIL_USERNAME.
MAIL_FROM=

# Google OAuth (admin "Sign in with Google" + Sheets export).
# The redirect URI must match this path exactly, note the hyphen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google-callback

# Google Apps Script webhook for job postings.
APPS_SCRIPT_URL=
